                "teller":null,
                "title":null
            },
            {
                "id":32,
                "place":null,
                "content":"Tôi muốn làm cho rõ ngọn ngành vấn đề chứ không phải đang làm mình làm mẩy, mong ngài hãy hiểu cho.",
